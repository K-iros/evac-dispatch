.page {
  padding: 24rpx;
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.card-title {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.profile {
  font-size: 64rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  font-size: 24rpx;
  color: #64748b;
}

.field {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #94a3b8;
}

.field-value {
  flex: 1;
}

.warn {
  color: #dc2626;
}

.helper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 28rpx;
}

.helper:last-child {
  border-bottom: none;
}

.helper-right {
  display: flex;
  gap: 8rpx;
}

.mini-map {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.nav-btn {
  margin-top: 8rpx;
}
