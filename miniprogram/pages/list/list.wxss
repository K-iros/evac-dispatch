.page {
  padding: 24rpx;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-red {
  color: #dc2626;
}

.stat-green {
  color: #059669;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.card-left {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile {
  font-size: 34rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
}

.address {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  margin-left: 16rpx;
}

.departure {
  font-size: 22rpx;
  color: #64748b;
}

.countdown {
  font-size: 26rpx;
  color: #0f172a;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #94a3b8;
}
